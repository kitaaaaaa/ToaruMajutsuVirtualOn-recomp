+/* Jump tables known from outside (BB_RECOMP_TABLES=TSV: jump offset, table offset, entries; for
+ * forms detect_table does not follow, such as an index from BEXTR bounded through another register).
+ * A known table wins over detection, and any disagreement between them is reported. */
+typedef struct { uint64_t jump, table, entries; } KnownTable;
+static KnownTable *known_tables;
+static size_t known_table_count;
+static uint64_t tables_both, tables_known_only, tables_detected_only, tables_differ;
+
+static int known_order(const void *a, const void *b) {
+    const uint64_t x = ((const KnownTable *)a)->jump, y = ((const KnownTable *)b)->jump;
+    return x < y ? -1 : x > y;
+}
+
+static void load_known_tables(const char *path) {
+    FILE *f = fopen(path, "r");
+    if (!f) { perror(path); exit(1); }
+    char line[128];
+    size_t capacity = 0;
+    while (fgets(line, sizeof(line), f)) {
+        unsigned long long jump, table, entries;
+        if (sscanf(line, "%llx\t%llx\t%llu", &jump, &table, &entries) != 3) continue;
+        if (known_table_count == capacity) {
+            capacity = capacity ? capacity * 2 : 1024;
+            known_tables = realloc(known_tables, capacity * sizeof(*known_tables));
+        }
+        known_tables[known_table_count++] = (KnownTable){jump, table, entries};
+    }
+    fclose(f);
+    qsort(known_tables, known_table_count, sizeof(*known_tables), known_order);
+}
