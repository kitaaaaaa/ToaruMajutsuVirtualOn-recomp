# A whitelist: nothing is published unless it is named here. Game data must never match.
/*
!/.gitignore
!/README.md
!/PASSDOWN.md
!/LICENSE
!/analysis/
!/port/
!/translation/

/analysis/*
!/analysis/scripts/

/port/*
!/port/*.ps1
!/port/runtime/
!/port/patches/
!/port/gpu/

/port/gpu/build/
/port/gpu/externals/

# Never, wherever they turn up.
*.pkg
*.elf
*.prx
*.sprx
*.self
*.bin
*.dll
*.exe
*.obj
*.lib
*.pdb
*.png
*.log
*.map
*.tsv
*.csv
*.DAT
__pycache__/
*.pyc
